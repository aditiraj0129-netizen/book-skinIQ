# Copy to .env and fill in real values. Never commit the real .env.

DATABASE_URL=sqlite:///./dev.db

JWT_SECRET=please-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Optional. If unset, the app runs on the deterministic rule-based fallback
# NLU instead of Grok (see app/services/nlu_fallback.py).
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# --- RAG / embeddings / vector store ---
# xAI has no public embeddings endpoint, so embeddings are configured
# separately. Leave OPENAI_API_KEY unset to use the fully local, offline
# hashing-based embedder (see app/services/embeddings.py) — RAG still works
# end-to-end with zero external calls, just with lexical (not semantic)
# retrieval. Set it to use real neural embeddings instead.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# "faiss" = local, file-persisted index, zero extra infra (default).
# "pgvector" = production backend using the Postgres pgvector extension.
#   Requires the pgvector extension enabled on DATABASE_URL's database, and
#   running `python -m app.build_rag_index` once as part of deployment.
VECTOR_STORE_BACKEND=faiss
FAISS_INDEX_DIR=data/faiss_index
RAG_TOP_K=4

BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18
SLOT_DURATION_MINUTES=30
BOOKING_HORIZON_DAYS=30

FRONTEND_ORIGIN=http://localhost:5173
